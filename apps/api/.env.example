# ==============================================================================
# Bot Service API - Variáveis de Ambiente
# ==============================================================================
# Porta em que o servidor Express irá escutar
PORT=3001

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Origem permitida para requisições CORS.
# Em desenvolvimento: http://localhost:5173
# Em produção: deve conter a URL/origem pública real do frontend (ex.: https://app.meudominio.com)
CORS_ORIGIN=http://localhost:5173
