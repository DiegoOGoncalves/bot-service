# ==============================================================================
# Bot Service - Exemplo de Variáveis de Ambiente Globais
# ==============================================================================
# Cada aplicação possui seu próprio arquivo de configuração local dedicado:
# - Backend API: apps/api/.env.example
# - Frontend Web: apps/web/.env.example
# ==============================================================================

# Backend API (apps/api/.env)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend Web (apps/web/.env)
VITE_API_URL=http://localhost:3001
