# ==============================================================================
# Bot Service - Referência de Configuração de Ambiente
# ==============================================================================
# NOTA: Este arquivo na raiz serve apenas como DOCUMENTAÇÃO E REFERÊNCIA GERAL.
# As aplicações do monorepo carregam suas variáveis diretamente de seus próprios
# arquivos locais dentro de cada pacote:
#
# 1. Backend API:
#    Arquivo: apps/api/.env
#    Modelo:  apps/api/.env.example (define PORT, NODE_ENV, CORS_ORIGIN)
#
# 2. Frontend Web:
#    Arquivo: apps/web/.env
#    Modelo:  apps/web/.env.example (define VITE_API_URL)
# ==============================================================================

# Backend API (copie para apps/api/.env)
PORT=3001
NODE_ENV=development
# Em dev: http://localhost:5173 | Em produção: origem pública real do frontend
CORS_ORIGIN=http://localhost:5173

# Frontend Web (copie para apps/web/.env)
VITE_API_URL=http://localhost:3001
